{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "isolatedModules": true,
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "playwright/**/*.ts", "typed_caller.ts"]
}
